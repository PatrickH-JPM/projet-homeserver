        "enableInfiniteScrolling": true,
        "showControls": true,
        "fontSize": "small",
        "noDataText": "Aucun événement sur la période"
      },
      "description": "Nouvelles lignes en bas ; historique accessible par scroll.",
      "maxDataPoints": 250,
      "fieldConfig": {
        "defaults": {
          "noValue": "Aucun événement sur la période"
