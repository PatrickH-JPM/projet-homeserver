    {
      "id": 14,
      "title": "WAN entrant — connexions actives",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(Home_server_wan_inbound_connections_total)",
          "legendFormat": "Connexions",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": true,
        "text": {
          "titleSize": 15,
          "valueSize": 24
        }
      }
    },
    {
      "id": 4,
      "title": "WireGuard — pairs actifs",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (peer,name) (Home_server_wireguard_peer_active)",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "machine": true
            },
            "indexByName": {
              "peer": 0,
              "name": 1,
              "Value": 2
            },
            "renameByName": {
              "peer": "IP WireGuard",
              "name": "Appareil",
              "Value": "État"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Aucun pair actif"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "État"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "ACTIF",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "ACTIF = pair WireGuard observé dans une connexion Linux active. Le handshake exact reste dépendant de la télémétrie ER605."
    },
    {
      "id": 13,
      "title": "WAN entrant actif — IP publiques uniquement",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (peer,protocol,port,service) (Home_server_wan_inbound_connections)",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "machine": true
            },
            "indexByName": {
              "peer": 0,
              "Value": 1,
              "service": 2,
              "port": 3,
              "protocol": 4
            },
            "renameByName": {
              "peer": "IP distante",
              "Value": "Connexions actives",
              "service": "Service",
              "port": "Port",
              "protocol": "Protocole"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Aucune connexion WAN entrante active"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Connexions actives"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 150
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "description": "Uniquement les flux actifs dont le tuple original est IP publique → IP locale. Les connexions sortantes vers Internet sont exclues."
    },
    {
      "id": 7,
      "title": "Connexions réseau — historique par état",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "Home_server_conntrack_connections{state=\"ESTABLISHED\"}",
          "legendFormat": "ESTABLISHED"
        },
        {
          "refId": "B",
          "expr": "Home_server_conntrack_connections{state=\"SYN_SENT\"}",
          "legendFormat": "SYN_SENT"
        },
        {
          "refId": "C",
          "expr": "Home_server_conntrack_connections{state=\"SYN_RECV\"}",
          "legendFormat": "SYN_RECV"
        },
        {
          "refId": "D",
          "expr": "Home_server_conntrack_connections{state=\"TIME_WAIT\"}",
          "legendFormat": "TIME_WAIT"
        },
        {
          "refId": "E",
          "expr": "Home_server_conntrack_connections{state=\"FIN_WAIT\"}",
          "legendFormat": "FIN_WAIT"
        },
        {
          "refId": "F",
          "expr": "Home_server_conntrack_connections{state=\"CLOSE_WAIT\"}",
          "legendFormat": "CLOSE_WAIT"
        },
        {
          "refId": "G",
          "expr": "Home_server_conntrack_connections{state=\"UDP\"}",
          "legendFormat": "UDP"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 18,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "description": "Graphe empilé façon Munin ; nécessite snapshot périodique conntrack."
    },
    {
      "id": 5,
      "title": "Console ER605 / WireGuard",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
