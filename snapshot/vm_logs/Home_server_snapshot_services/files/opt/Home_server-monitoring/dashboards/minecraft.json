{
  "uid": "Home_server-minecraft",
  "title": "Minecraft",
  "schemaVersion": 39,
  "version": 4,
  "editable": false,
  "tags": [
    "Home_server"
  ],
  "timezone": "browser",
  "refresh": "2s",
  "liveNow": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "2s",
      "3s",
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Console Minecraft",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 20,
        "h": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"Home_server\"} | json | tag = \"MC-SERVEUR\" | line_format \"{{.message}}\"",
          "queryType": "range",
          "maxLines": 300,
          "direction": "backward"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": false,
        "sortOrder": "Ascending",
        "dedupStrategy": "none",
        "enableInfiniteScrolling": true,
        "showControls": true,
        "fontSize": "small",
        "noDataText": "Aucun événement sur la période"
      },
      "description": "Console stdout/stderr réelle du conteneur Minecraft via Docker → syslog. Nouvelles lignes en bas.",
      "maxDataPoints": 300,
      "fieldConfig": {
        "defaults": {
          "noValue": "Aucun événement sur la période"
        }
      }
    },
    {
      "id": 2,
      "title": "État serveur",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 2
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(Home_server_minecraft_running{machine=\"Home_server_mc\"}) or vector(0)",
          "legendFormat": "Serveur",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "HORS LIGNE",
                  "color": "red"
                },
                "1": {
                  "text": "EN LIGNE",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "vertical",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "wideLayout": false,
        "text": {
          "titleSize": 14,
          "valueSize": 19
        }
      }
    },
