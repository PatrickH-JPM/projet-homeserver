    {
      "id": 1,
      "title": "Home_server — hyperviseur",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"node\",machine=\"Home_server\"}",
          "legendFormat": "État"
        },
        {
          "refId": "B",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node\",machine=\"Home_server\",mode=\"idle\"}[2m])))",
          "legendFormat": "CPU"
        },
        {
          "refId": "C",
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{job=\"node\",machine=\"Home_server\"} / node_memory_MemTotal_bytes{job=\"node\",machine=\"Home_server\"}))",
          "legendFormat": "RAM"
        },
        {
          "refId": "D",
          "expr": "100 * node_filesystem_avail_bytes{job=\"node\",machine=\"Home_server\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{job=\"node\",machine=\"Home_server\",mountpoint=\"/\",fstype!~\"tmpfs|overlay|squashfs\"}",
          "legendFormat": "Disque libre"
        },
        {
          "refId": "E",
          "expr": "time() - node_boot_time_seconds{job=\"node\",machine=\"Home_server\"}",
          "legendFormat": "Uptime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
