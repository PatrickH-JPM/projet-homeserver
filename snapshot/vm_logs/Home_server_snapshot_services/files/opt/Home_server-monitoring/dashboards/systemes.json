    {
      "id": 4,
      "title": "Étages de sécurité",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 8
      },
      "options": {
        "mode": "markdown",
        "content": "### 1 — Réseau / ER605\nVLAN, routage, ACL et filtrage inter-réseaux.\n\n### 2 — Pare-feu Linux\nFiltrage local sur l’hyperviseur et les deux VM.\n\n### 3 — CrowdSec\nDétection comportementale puis décision de bannissement.\n\n### 4 — Services exposés\nSSH, nginx, Wings/Pterodactyl et leurs contrôles d’accès.\n\n### 5 — Supervision / alerte\nPrometheus, Loki/Grafana et chaîne SMTP.\n\n**Chaque étage couvre un risque différent : une couche verte ne remplace pas les autres.**\n"
      }
    },
    {
      "id": 5,
      "title": "Sécurité & supervision — état synthétique",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 6,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(Home_server_service_active{service=\"crowdsec\"})",
          "legendFormat": "CrowdSec"
        },
        {
          "refId": "B",
          "expr": "min(Home_server_service_active{service=\"crowdsec-firewall-bouncer\"})",
          "legendFormat": "Bouncer"
        },
        {
          "refId": "C",
          "expr": "min(Home_server_service_active{service=\"ssh\"})",
          "legendFormat": "SSH"
        },
        {
          "refId": "D",
          "expr": "max(Home_server_service_active{service=\"nginx\"})",
          "legendFormat": "nginx"
        },
        {
          "refId": "E",
          "expr": "max(Home_server_service_active{service=\"wings\"})",
          "legendFormat": "Wings"
        },
        {
          "refId": "F",
          "expr": "min(up{job=\"node\"})",
          "legendFormat": "Exporteurs Linux"
        },
        {
          "refId": "G",
          "expr": "1 - max(Home_server_mail_error)",
          "legendFormat": "SMTP"
        },
        {
          "refId": "H",
          "expr": "Home_server_mail_pending_events",
          "legendFormat": "Événements mail en attente"
        },
        {
          "refId": "I",
          "expr": "max(time() - Home_server_collecte_timestamp_seconds)",
          "legendFormat": "Âge collecte"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "CrowdSec|Bouncer|SSH|nginx|Wings|Exporteurs Linux|SMTP"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "KO",
                        "color": "red"
                      },
                      "1": {
                        "text": "OK",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Événements mail en attente"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 1
                    },
                    {
                      "color": "red",
                      "value": 20
                    }
                  ]
                }
              }
