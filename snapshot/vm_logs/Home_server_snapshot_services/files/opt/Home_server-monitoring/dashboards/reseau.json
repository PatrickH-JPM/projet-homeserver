    {
      "id": 5,
      "title": "IPs externes vues — 5 dernières minutes",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(20, sum by (peer) (count_over_time({job=\"Home_server\",tag=\"NETFLOW\"} | json | line_format \"{{.message}}\" | regexp \"src=(?P<peer>[0-9]+\\\\.[0-9]+\\\\.[0-9]+\\\\.[0-9]+)\" | peer !~ \"^(10\\.|127\\.|169\\.254\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|192\\.168\\.)\" [5m])))",
          "legendFormat": "{{peer}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        },
        {
          "refId": "B",
          "expr": "topk(20, sum by (peer) (count_over_time({job=\"Home_server\",tag=\"NETFLOW\"} | json | line_format \"{{.message}}\" | regexp \"dst=(?P<peer>[0-9]+\\\\.[0-9]+\\\\.[0-9]+\\\\.[0-9]+)\" | peer !~ \"^(10\\.|127\\.|169\\.254\\.|172\\.(1[6-9]|2[0-9]|3[01])\\.|192\\.168\\.)\" [5m])))",
          "legendFormat": "{{peer}}",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "vertical",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true
      },
      "description": "IP publiques brutes vues dans les événements conntrack récents. Le nombre affiché correspond au nombre d’événements."
    },
