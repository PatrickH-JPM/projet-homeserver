{
  "input_log": "/var/log/Home_server/brut.log",
  "output_log": "/var/log/Home_server/evenements-v2.jsonl",
  "state_file": "/var/lib/Home_server-events-v2/state.json",
  "poll_interval_seconds": 0.25,
  "probe_timeout_seconds": 5,
  "supervision_heartbeat_seconds": 60,
  "firewall_counter_window_seconds": 60,
  "scan_window_seconds": 60,
  "scan_distinct_ports_threshold": 20,
  "ssh_bruteforce_window_seconds": 60,
  "ssh_bruteforce_threshold": 3,
  "sources": {
    "home-server": "server",
    "home-server-services": "vm_logs",
    "home-server-mc": "vm_mc",
    "ER605": "ER605"
  },
  "known_addresses": {
    "192.168.3.10": "server",
    "192.168.4.10": "vm_mc",
    "192.168.5.10": "vm_logs",
    "192.168.3.1": "ER605",
    "192.168.4.1": "ER605",
    "192.168.5.1": "ER605"
  },
  "service_probes": [
    {
      "id": "minecraft_exporter",
      "source": "vm_logs",
      "src_ip": "192.168.5.10",
      "dst_ip": "192.168.4.10",
      "dst_port": 9940,
      "category": "SUPERVISION",
      "service": "minecraft_exporter",
      "up_level": "INFO",
      "down_level": "ALERTE",
      "up_type": "supervision.minecraft.up",
      "down_type": "supervision.minecraft.down",
      "up_message": "Infos Minecraft reçues depuis vm_mc",
      "down_message": "Exporteur Minecraft inaccessible sur vm_mc:9940"
    },
    {
      "id": "vm_mc_node_exporter",
      "source": "vm_logs",
      "src_ip": "192.168.5.10",
      "dst_ip": "192.168.4.10",
      "dst_port": 9100,
      "category": "SUPERVISION",
      "service": "node_exporter",
      "up_level": "INFO",
      "down_level": "ALERTE",
      "up_type": "supervision.vm_mc.up",
      "down_type": "supervision.vm_mc.down",
      "up_message": "Infos système reçues depuis vm_mc",
      "down_message": "Exporteur système inaccessible sur vm_mc:9100"
    },
    {
      "id": "server_node_exporter",
      "source": "vm_logs",
      "src_ip": "192.168.5.10",
      "dst_ip": "192.168.3.10",
      "dst_port": 9100,
      "category": "SUPERVISION",
      "service": "node_exporter",
      "up_level": "INFO",
      "down_level": "ALERTE",
      "up_type": "supervision.server.up",
      "down_type": "supervision.server.down",
      "up_message": "Infos système reçues depuis server",
      "down_message": "Exporteur système inaccessible sur server:9100"
    },
    {
      "id": "wings_api",
      "source": "vm_logs",
      "src_ip": "192.168.5.10",
      "dst_ip": "192.168.4.10",
      "dst_port": 8080,
      "category": "PTERO",
      "service": "wings",
      "up_level": "INFO",
      "down_level": "ALERTE",
      "up_type": "ptero.wings.up",
      "down_type": "ptero.wings.down",
      "up_message": "Communication Pterodactyl → Wings reçue sur vm_mc:8080",
      "down_message": "Wings inaccessible sur vm_mc:8080"
    },
    {
      "id": "crowdsec_lapi",
      "source": "vm_logs",
      "src_ip": "127.0.0.1",
      "dst_ip": "127.0.0.1",
      "dst_port": 8081,
      "category": "CrowdSec",
      "service": "crowdsec",
      "up_level": "INFO",
      "down_level": "CRITIQUE",
      "up_type": "crowdsec.api.up",
      "down_type": "crowdsec.api.down",
      "up_message": "API locale CrowdSec joignable sur 127.0.0.1:8081",
      "down_message": "CrowdSec ne répond plus sur 127.0.0.1:8081"
    }
  ]
}
