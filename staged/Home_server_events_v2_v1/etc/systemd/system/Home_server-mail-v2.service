[Unit]
Description=Home_server alertes mail V2
After=Home_server-events-v2.service

[Service]
Type=oneshot
User=Home_servermail
Group=Home_servermail
ExecStart=/usr/local/sbin/Home_server-mail-v2.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/Home_server-mail /etc/Home_server-events-v2 /var/log/Home_server
ReadWritePaths=/var/lib/Home_server-mail-v2 /var/lib/Home_server-mail-public
